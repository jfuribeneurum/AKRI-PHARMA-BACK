PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=akripass
DB_NAME=akripharmacy

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=12h

CORS_ORIGIN=http://localhost:4200,http://localhost:8080
ALLOW_STOCK_NEGATIVE=false

SIESA_MOCK_MODE=true
SIESA_TIMEOUT_MS=15000

UPLOAD_DIR=uploads

DB_STARTUP_MAX_ATTEMPTS=30
DB_STARTUP_DELAY_MS=2000

METRICS_ENABLED=true
METRICS_TOKEN=
REQUEST_TRACE_ENABLED=true
REQUEST_TRACE_EXCLUDE_PATHS=/api/health,/api/ready,/healthz,/metrics
TRUST_PROXY=false
SIGNATURE_ENFORCE_PIN=true
SIGNATURE_HASH_SALT=change_me
APP_BASE_URL=http://localhost:8080
BACKUP_DIR=./backups
